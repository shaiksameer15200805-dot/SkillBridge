# SkillBridge Backend Environment Configuration Example
# Copy this file to .env and configure as needed.

PORT=5000
JWT_SECRET=
SECRET_KEY=

# Database Configuration
# Set USE_SQLITE=1 to force local SQLite database (default fallback)
USE_SQLITE=1

# MySQL Configuration (for production / hackathon evaluation)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=aicp
MYSQL_URL=
